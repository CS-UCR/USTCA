<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{% block title %}USTCA Dashboard{% endblock %}</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}" />
</head>
<body class="bg-gray-100 text-gray-800">

  <nav class="bg-white shadow">
    <div class="container mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/" class="text-2xl font-bold text-indigo-600">United States Temperature and Climate Analysis</a>
      <ul class="flex space-x-6">
        <li><a href="/regional"    class="nav-link">Regional</a></li>
        <li><a href="/seasonal"  class="nav-link">Seasonal</a></li>
        <li><a href="/elevation" class="nav-link">Elevation</a></li>
        <li><a href="/climate"   class="nav-link">Climate</a></li>
      </ul>
    </div>
  </nav>

  <main class="container mx-auto px-4 py-6">
    {% block content %}{% endblock %}
  </main>

  
  {% block scripts %}
  {% endblock %}
</body>
</html>
